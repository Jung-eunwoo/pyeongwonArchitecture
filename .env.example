# 견적 문의 함수(netlify/functions/contact.ts)용 EmailJS 설정
# 운영: Netlify 대시보드 → Site configuration → Environment variables 에 등록
# 로컬: 이 파일을 .env 로 복사해 값을 채운 뒤 `netlify dev` 실행 (.env 는 커밋 금지)
# 자세한 내용: docs/inquiry-email.md

EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_company_template_id_here
EMAILJS_CUSTOMER_TEMPLATE_ID=your_customer_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here
